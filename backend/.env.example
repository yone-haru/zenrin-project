# Azure OpenAI (GPT-4o Vision / Embeddings)
# 未設定の場合は決定的スタブ（画像/テキストのハッシュ値ベース）にフォールバックする。
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_VISION_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# CORS（カンマ区切りで複数指定可）
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# 外部API（無料の公開インスタンス。商用運用時は自前ホストや商用APIに差し替えること）
# OSRM公開デモサーバーは実質carプロファイルのみの稼働・商用利用不可。
# 自前ホストする場合は https://github.com/Project-OSRM/osrm-backend を参照し、
# foot.lua プロファイルでビルドしたインスタンスのURLを指定する。
OSRM_BASE_URL=https://router.project-osrm.org/route/v1
OSRM_PROFILE=foot
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# ジオコーディングの検索対象国（カンマ区切り。空文字で制限なし）
NOMINATIM_COUNTRY_CODES=jp

# HTTPクライアント設定
HTTP_TIMEOUT_S=10.0
HTTP_MAX_RETRIES=2
NOMINATIM_MIN_INTERVAL_S=1.0

# 画像アップロード制限
MAX_IMAGE_SIZE_BYTES=10485760
MAX_IMAGES_PER_REPORT=5

# ログレベル
LOG_LEVEL=INFO

# 通報管理API（PATCH /api/reports/{id}/status）の管理者トークン。
# 未設定（空文字）の場合はこのAPIは常に401を返す。管理パネルを使う場合のみ設定する。
ADMIN_TOKEN=
